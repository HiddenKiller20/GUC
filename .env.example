# Owner email is bound to the initial admin account; set/change the password with npm run setup.
OWNER_EMAIL=bigt1576@gmail.com
PORT=3000
HOST=127.0.0.1
# Set to production only when behind HTTPS. Secure cookies are required in production.
NODE_ENV=development
# Set TRUST_PROXY=1 only when behind a proxy you configure and trust.
TRUST_PROXY=0
# Optional: set SITE_ORIGIN=https://your-domain.example to require this exact origin on writes.
SITE_ORIGIN=
